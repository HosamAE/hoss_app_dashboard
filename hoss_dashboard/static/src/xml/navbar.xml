<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Inherit Odoo's main navbar to append our Customizer button inside the systray -->
    <t t-name="hoss.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="inside">
            <button class="hoss_nav_customizer_btn border-0 bg-transparent px-3 text-white" 
                    title="Customize Dashboard" 
                    t-on-click="onHossCustomizeClick"
                    style="display: none; align-items: center; justify-content: center; height: 100%; cursor: pointer;">
                <i class="fa fa-paint-brush fs-5"></i>
            </button>
        </xpath>
    </t>
</templates>
